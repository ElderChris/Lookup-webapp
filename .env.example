# =============================================================================
# .env.example — Lookup
# =============================================================================
# Copia in `.env` e modifica i valori se necessario.
# Per Fase 1a i default sono sufficienti — l'app gira senza configurazione.
#
#   cp .env.example .env
#   docker compose up
# =============================================================================

# -----------------------------------------------------------------------------
# Fase 0d — Frontend (nginx)
# -----------------------------------------------------------------------------
WEB_PORT=8080

# -----------------------------------------------------------------------------
# Fase 1a — PostgreSQL + PostGIS
# -----------------------------------------------------------------------------
POSTGRES_USER=lookup
POSTGRES_PASSWORD=lookup_dev
POSTGRES_DB=lookup
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Fase 1a — Redis
# -----------------------------------------------------------------------------
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Fase 1c — Backend Fastify (porta esposta dal container)
# -----------------------------------------------------------------------------
# Letta da docker-compose per il port mapping del servizio api.
# Il backend stesso legge le sue variabili runtime da apps/api/.env.
API_PORT=3000
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Fase 1b — Backend (Prisma) usa un proprio .env in apps/api/
# -----------------------------------------------------------------------------
# DATABASE_URL e altre variabili runtime del backend stanno in apps/api/.env
# (non qui). Prisma cerca il .env nella cartella dello schema, non in root.
# Per setup iniziale:
#   cd apps/api && cp .env.example .env
#
# Le variabili POSTGRES_* qui sopra sono lette da docker-compose.yml per
# avviare il container postgres con le credenziali giuste.

# -----------------------------------------------------------------------------
# TODO(fase1c) — Backend Fastify runtime (vedi apps/api/.env)
# -----------------------------------------------------------------------------
# API_PORT=3000
# SESSION_SECRET=cambiami-in-produzione-con-stringa-cryptographically-random-32-byte
# NODE_ENV=development

# -----------------------------------------------------------------------------
# Mailpit (cattura le email inviate dall'applicazione in sviluppo)
# -----------------------------------------------------------------------------
# MAIL_SMTP_PORT=1025
# MAIL_WEB_PORT=8025
# SMTP_HOST=mailpit
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Lookup <noreply@lookup.local>"

# -----------------------------------------------------------------------------
# Opzionale — pgAdmin (profilo `admin`)
# -----------------------------------------------------------------------------
# Per attivare: docker compose --profile admin up -d
# Poi http://localhost:5050
PGADMIN_EMAIL=admin@localhost
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
