{
  "name": "libreria-diffusa",
  "version": "3.0.0-alpha.0",
  "private": true,
  "description": "Piattaforma di geolocalizzazione culturale per la condivisione del patrimonio librario privato — prototipo accademico in transizione verso Alpha.",
  "type": "module",
  "scripts": {
    "dev": "python3 no-cache-server.py 8765",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "lint": "eslint js/",
    "lint:fix": "eslint js/ --fix",
    "format": "prettier --write \"{js,tests}/**/*.{js,json}\"",
    "format:check": "prettier --check \"{js,tests}/**/*.{js,json}\"",
    "check": "npm run lint && npm run format:check && npm test",
    "prepare": "[ -d .git ] && husky || true"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "eslint": "^9.13.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3"
  },
  "lint-staged": {
    "js/**/*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "tests/**/*.js": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "license": "GPL-3.0"
}
