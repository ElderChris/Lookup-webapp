# =============================================================================
# apps/api/.env.test
# =============================================================================
# Variabili ambiente usate dai test Vitest. Distinte da .env (sviluppo)
# perche' i test girano su un DB separato `lookup_test` per non interferire
# con i dati di sviluppo.
#
# Caricato dal flag `node --env-file=.env.test` (vedi script test/test:watch
# in package.json).
#
# Il DB `lookup_test` viene creato:
#   - Automaticamente al primo boot di postgres (vedi infra/postgres/init.sql)
#   - Manualmente con `npm run test:setup-db` se manca
# =============================================================================

DATABASE_URL=postgresql://lookup:lookup_dev@localhost:5432/lookup_test?schema=public
NODE_ENV=test
API_PORT=3001
LOG_LEVEL=silent
REDIS_URL=redis://localhost:6379/1
CORS_ORIGINS=http://localhost:8080

# Fase 3.1 — Better Auth (test env)
BETTER_AUTH_SECRET=test-secret-32chars-min-for-vitest-only-not-prod
BETTER_AUTH_URL=http://localhost:3001
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=test@lookup.local
