{
  "name": "@lookup/api",
  "version": "3.0.0-beta.10",
  "private": true,
  "description": "Backend di Lookup — Node + Fastify + Prisma + PostgreSQL.",
  "type": "module",
  "main": "src/server.js",
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "scripts": {
    "postinstall": "prisma generate && node scripts/setup-env.mjs",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "start:prod": "node src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:setup-db": "node tests/setup-test-db.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:baseline": "node scripts/create-baseline-migration.mjs",
    "db:migrate:reset": "prisma migrate reset",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:format": "prisma format"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^6.1.4",
    "@lookup/shared": "*",
    "@prisma/client": "^5.22.0",
    "@prometheus-io/client": "^0.16.1",
    "better-auth": "^1.7.0",
    "bullmq": "^5.80.0",
    "fastify": "^5.12.0",
    "fastify-plugin": "^6.0.1",
    "ioredis": "^5.11.0",
    "nodemailer": "^10.6.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.1.1",
    "pino-pretty": "^13.2.0",
    "prisma": "^5.22.0",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=26"
  }
}
