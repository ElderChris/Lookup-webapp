# =============================================================================
# apps/api/.env.example
# =============================================================================
# Copia in `apps/api/.env` e modifica se necessario.
#
# Setup iniziale:
#   cd apps/api
#   cp .env.example .env       (Windows: copy .env.example .env)
#
# Perche' un .env separato per il backend?
# Prisma e Node --env-file caricano .env dalla cwd di esecuzione. In un
# monorepo con npm workspaces, ogni workspace ha il proprio .env. Il
# .env di root resta per docker-compose (porte container, password
# postgres lette dal compose file).
# =============================================================================

# -----------------------------------------------------------------------------
# Fase 1b — Prisma / database
# -----------------------------------------------------------------------------
# Il default presuppone POSTGRES_PORT=5432 nel .env di root (default compose).
DATABASE_URL=postgresql://lookup:lookup_dev@localhost:5432/lookup?schema=public

# -----------------------------------------------------------------------------
# Fase 1c — Fastify runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000

# Pino logger level: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# Origini CORS permesse (CSV). Localhost su qualunque porta e' sempre permessa
# in aggiunta a quelle qui sotto, per facilitare il dev.
CORS_ORIGINS=http://localhost:8080,http://localhost:8765

# -----------------------------------------------------------------------------
# Fase 1c — Redis (per healthcheck; usato in 1e+ per session/rate-limit)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Fase 3.1 — Better Auth + email (Mailpit in dev)
# -----------------------------------------------------------------------------
# Segreto per firma cookie session (min 32 caratteri). In produzione:
# openssl rand -base64 32
BETTER_AUTH_SECRET=DEV-only-CHANGE-in-production-32chars-min-random

# URL base del backend (usato nei link email di verify + reset)
BETTER_AUTH_URL=http://localhost:3000


# SMTP — Mailpit in dev, configurato come un provider reale: STARTTLS
# obbligatorio e credenziali (quelle di docker-compose.yml).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=lookup
SMTP_PASS=lookup-dev
SMTP_FROM=Lookup <no-reply@lookup.local>
# Solo per Mailpit (certificato autofirmato). In produzione NON impostarla.
SMTP_TLS_VERIFY=false
#
# Produzione, esempi:
#   STARTTLS (587):  SMTP_HOST=smtp.resend.com SMTP_PORT=587
#   TLS implicito:   SMTP_HOST=smtp.resend.com SMTP_PORT=465 (SMTP_SECURE automatico)
#   SMTP_USER=... SMTP_PASS=...  (dal provider)
# STARTTLS e' obbligatorio di default (SMTP_REQUIRE_TLS=true): se il server
# non lo offre l'invio fallisce invece di partire in chiaro.
